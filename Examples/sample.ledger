; Sample journal — demonstrates the plain-text accounting format
; supported by SwiftLedger.

; Account declarations are optional. They let you explicitly set the
; account type when the name root doesn't match the recognised conventions.
account Assets:Checking
account Assets:Savings
account Assets:Brokerage
account Assets:PettyCash
account Liabilities:CreditCard
account Equity:Opening
account Income:Salary
account Income:Freelance
account Expenses:Rent
account Expenses:Food:Groceries
account Expenses:Food:Restaurants
account Expenses:Transport
account Expenses:Utilities

; ── January ─────────────────────────────────────────────────────────────────

2024-01-01 * Opening balances
    Assets:Checking        $2500.00
    Assets:Savings         $5000.00
    Equity:Opening

2024-01-15 * Salary
    Assets:Checking        $3200.00
    Income:Salary

2024-01-01 * Rent — January
    Expenses:Rent          $1200.00
    Assets:Checking

2024-01-07 Groceries
    Expenses:Food:Groceries    $87.45
    Liabilities:CreditCard

2024-01-12 Lunch with client
    Expenses:Food:Restaurants  $42.00
    Liabilities:CreditCard

2024-01-20 Monthly transit pass
    Expenses:Transport         $95.00
    Assets:Checking

2024-01-22 Electricity bill
    Expenses:Utilities         $68.30
    Assets:Checking

2024-01-28 Pay off credit card
    Liabilities:CreditCard     $129.45
    Assets:Checking

; ── February ────────────────────────────────────────────────────────────────

2024-02-01 * Rent — February
    Expenses:Rent          $1200.00
    Assets:Checking

2024-02-05 Supermarket run
    Expenses:Food:Groceries    $112.60
    Liabilities:CreditCard

2024-02-10 Freelance project payment
    Assets:Checking        $800.00
    Income:Freelance

2024-02-15 * Salary
    Assets:Checking        $3200.00
    Income:Salary

2024-02-18 ! Pending refund  ; status: pending
    Assets:Checking        $35.00
    Expenses:Food:Restaurants

2024-02-20 Bus and train fares
    Expenses:Transport         $42.50
    Assets:Checking

2024-02-25 Internet and phone
    Expenses:Utilities         $55.00
    Assets:Checking

2024-02-28 Pay off credit card
    Liabilities:CreditCard     $112.60
    Assets:Checking

; ── Entries with fewer than two postings ────────────────────────────────────
; The rule is that every commodity nets to zero, not that there are two
; postings, so these are valid in ledger, in hledger and here.

; A dated line on its own is how a journal keeps a note.
2024-02-03 Called the bank about the card fee

; A single posting of zero touches an account without moving money.
2024-02-06 Opened a brokerage account
    Assets:Brokerage       $0

; With nothing to balance against, an elided amount reads as zero, exactly
; as if 0 had been written.
2024-02-08 Set up the petty cash tin
    Assets:PettyCash

; The usual hledger shape: a zero posting carrying a balance assertion, which
; states the balance on that date without recording a movement. SwiftLedger
; preserves the assertion and does not check it.
2024-02-29 Statement check
    Assets:Savings         $0 = $5000.00

; ── Virtual postings ────────────────────────────────────────────────────────
; Parentheses make a posting virtual: it moves money in a tracking account
; outside the double-entry books and takes no part in balancing. Square
; brackets make it balanced virtual — exempt from balancing against the real
; postings, but the bracketed postings of one entry must sum to zero among
; themselves. Both names are stored bare, so a query finds the same account
; however the journal spells it.

2024-03-01 Groceries, and move the food envelope
    Expenses:Food:Groceries             $60.00
    Assets:Checking
    [Assets:Checking:Envelope:Food]     -$60.00
    [Assets:Checking:Available]         $60.00
    (Reserve:Capital)                   $250.00
